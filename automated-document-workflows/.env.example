# Database Configuration
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL: postgresql://user:password@localhost/automated_docs

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Application Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
LOG_LEVEL=INFO
MAX_FILE_SIZE=100MB
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff,docx

# Lid Vizion BaaS Integration (Optional)
# If both are set, BaaS will be used; otherwise local processing
LV_BAAS_API_KEY=
LV_BAAS_WORKFLOW_ID=
LV_BAAS_BASE_URL=https://api.lidvizion.com/v1

# Shopify Integration (Optional)
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=

# AWS S3 Integration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-west-2

# SFTP Integration (Optional)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=

# OCR Configuration
TESSERACT_CMD=tesseract
OCRMYPDF_TIMEOUT=300
OCR_LANGUAGE=eng
OCR_DPI=300

# Document Processing
TEMP_UPLOAD_DIR=./temp
OUTPUT_DIR=./outputs
TEMPLATE_DIR=./templates
RULES_DIR=./rules

# Bates Numbering
BATES_DEFAULT_PREFIX=BATES
BATES_PADDING=6

# Security
MASK_PII=True
QUARANTINE_DIR=./quarantine
MAX_PAGES_PER_DOCUMENT=1000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["http://localhost:3000"]

# Celery Configuration
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
CELERY_TASK_TIMEOUT=3600

# Performance
MAX_CONCURRENT_JOBS=5
CLEANUP_TEMP_FILES_HOURS=24